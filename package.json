{
  "name": "playholos",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A self-contained, data-informed 3D atlas from Earth to the Local Group.",
  "license": "MIT",
  "author": "John Polacek",
  "repository": "github:johnpolacek/playholos",
  "homepage": "https://playholos.com",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/serve.mjs",
    "play": "node scripts/play.mjs",
    "test": "node --test tests/*.test.mjs",
    "playtest:score": "node scripts/playtest-score.mjs",
    "playtest:judge": "node scripts/playtest-judge.mjs",
    "playtest:rate": "node scripts/playtest-rate.mjs",
    "playtest:capture": "node scripts/capture.mjs",
    "playtest:critic": "node scripts/playtest-critic.mjs",
    "playtest:local": "node scripts/playtest-local.mjs",
    "playtest:round": "node scripts/playtest-local.mjs blind --both",
    "playtest:climb": "node scripts/playtest-climb.mjs",
    "playtests": "node -e \"require('child_process').spawn(process.platform==='win32'?'explorer':process.platform==='darwin'?'open':'xdg-open',['playtests/regime.html'],{stdio:'ignore',detached:true}).unref()\"",
    "playtests:serve": "node scripts/playtests-serve.mjs"
  },
  "dependencies": {
    "astronomy-engine": "2.1.19",
    "gsap": "^3.15.0",
    "three": "0.180.0"
  },
  "devDependencies": {
    "esbuild": "0.25.9",
    "playwright": "^1.62.1"
  }
}
