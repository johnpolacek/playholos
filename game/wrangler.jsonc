{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holos",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-12",
  // Every page is the one client, so any address without a file serves index.html. Only /api/* reaches the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The apex is canonical. www serves the same Worker, so no one lands on a dead address.
  "routes": [
    { "pattern": "playholos.com", "custom_domain": true },
    { "pattern": "www.playholos.com", "custom_domain": true }
  ],
  // Logs every request and what the Worker writes to the console, so a Mind that can't answer shows why.
  "observability": { "enabled": true },
  // Six questions a minute from one address. Each one spends money, ours behind the code.
  "ratelimits": [{ "name": "MIND_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } }]
}
