{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "holos",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-10-12",
  // Every page is the one client, so any address without a file serves index.html. Only /api/* reaches the Worker.
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // The apex is canonical. www serves the same Worker, so no one lands on a dead address.
  "routes": [
    { "pattern": "playholos.com", "custom_domain": true },
    { "pattern": "www.playholos.com", "custom_domain": true }
  ],
  // Logs every request and what the Worker writes to the console, so a Mind that can't answer shows why.
  "observability": { "enabled": true },
  // The seeds' worlds, private, one read when a game first asks. scripts/worlds.mjs uploads game/data/worlds. 2026-10-31.
  // How people play, one anonymous row an event from lib/track.ts. scripts/events.mjs reads it. 2026-11-08.
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "holos_events" }],
  // What players with a pass may spend of ours each day: worker/allowance.ts, one instance. 2026-11-08.
  "durable_objects": { "bindings": [{ "name": "ALLOWANCE", "class_name": "Allowance" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Allowance"] }],
  // Turnstile's public key, which the page shows its check with. Its secret is TURNSTILE_SECRET, set with
  // npx wrangler secret put. With neither, no one gets a pass. 2026-11-08.
  "vars": { "TURNSTILE_SITE_KEY": "0x4AAAAAAF5KNiLWNtYVpwG4" },
  "r2_buckets": [{ "binding": "WORLDS", "bucket_name": "holos-worlds" }],
  // Six questions a minute from one address. Each one spends money, ours behind the code. The Mind's news, told
  // unasked, has three of its own, so it never takes a question's place. 2026-11-03.
  "ratelimits": [
    { "name": "MIND_LIMIT", "namespace_id": "1001", "simple": { "limit": 6, "period": 60 } },
    { "name": "MIND_NEWS_LIMIT", "namespace_id": "1002", "simple": { "limit": 3, "period": 60 } },
    // Players' notes from the menu, three a minute from one address. 2026-11-08.
    { "name": "FEEDBACK_LIMIT", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } }
  ]
}
