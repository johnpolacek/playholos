{
  "name": "game",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:cli": "MIND_VIA=cli pnpm dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "pnpm build && pnpm worlds && wrangler deploy",
    "worlds": "node scripts/worlds.mjs",
    "worlds:local": "node scripts/worlds.mjs --local",
    "events": "node scripts/events.mjs",
    "lint": "eslint",
    "test": "node --test lib/sim/sim.test.mts lib/mind/queue.test.mts lib/mind/news.test.mts lib/game/build-offer.test.mts",
    "check:mind": "node scripts/check-mind.mjs",
    "trace:mind": "node scripts/trace-mind.mjs",
    "review:mind": "node scripts/review-mind.mjs",
    "types:worker": "wrangler types ./worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.105",
    "@ai-sdk/react": "^4.0.177",
    "@fontsource-variable/suse": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "ai": "^7.0.173",
    "gsap": "^3.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.69.1",
    "@fontsource/suse": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "marked": "^18.2.0",
    "satori": "^0.63.2",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8",
    "wrangler": "^4.162.0"
  },
  "packageManager": "pnpm@10.6.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
